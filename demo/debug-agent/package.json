{
  "name": "mattermost-debug-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Mattermost @debug bot bridge powered by the Cursor SDK",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "start:dry": "DEBUG_AGENT_DRY_RUN=1 tsx src/index.ts",
